---
import Layout from '../layouts/Layout.astro';
import LegalDoc, { type Section } from '../components/LegalDoc.astro';
import { COMPANY, PRIVACY_UPDATED, SITE, SUPPORT_EMAIL } from '../config';

/*
 * 문안은 법무 검토를 거친 정본이다. 문장을 임의로 손보지 말 것 —
 * 고칠 일이 생기면 정본을 먼저 고치고, 여기에 그대로 옮긴 뒤
 * `config.ts` 의 `PRIVACY_UPDATED` 를 함께 올린다.
 */

const sections: Section[] = [
  {
    id: 'scope',
    title: 'Scope and who we are',
    body: [
      `Mirinae is an astrology-based service operated by ${COMPANY.legalName}, ${COMPANY.jurisdiction}, located at ${COMPANY.address} (“Mirinae,” “we,” “us,” or “our”). This Privacy Policy explains how we collect, use, disclose, and protect personal information when you use the Mirinae mobile application or another related service that links to this policy (collectively, the “Service”). Your use of the Service is also governed by our Terms of Service.`,
      'This policy does not apply to third-party websites, applications, or services that are governed by their own privacy policies.',
    ],
  },
  {
    id: 'information-we-collect',
    title: 'Information we collect',
    body: [
      'We collect the following categories of information.',
      { h3: '2.1 Information you provide' },
      {
        list: [
          'Account and profile information, such as your email address, authentication identifier, display name, and preferences. If you sign in through Apple or Google, we receive the information that provider makes available under your account settings.',
          'Birth information, including your date, time, and place of birth and the time zone associated with that information.',
          'Content, including chat messages, report intake responses, feedback, and information you provide when contacting support.',
        ],
      },
      'Please do not submit passwords, payment-card details, government identifiers, or personal information about another person unless you have the right to provide it.',
      { h3: '2.2 Information created through the Service' },
      'We create and store information needed to provide personalized features, including natal-chart data, readings, reports, chat responses, and personalization information inferred or summarized from your use of the Service. This information may reflect details you disclose in conversations and report inputs.',
      { h3: '2.3 Transaction information' },
      'When you purchase credits through an application store, the store processes your payment details. We receive limited transaction information, such as a transaction identifier, product purchased, purchase status, and refund or revocation status. We also maintain records of credit grants, purchases, and use. We do not receive your full payment-card number from the application store.',
      { h3: '2.4 Technical and usage information' },
      'We and the service providers that help us operate the Service may automatically collect technical and usage information, such as your IP address, device and operating-system information, app version, language and time-zone settings, interactions with the Service, and log, crash, and diagnostic data.',
    ],
  },
  {
    id: 'how-we-collect',
    title: 'How we collect information',
    body: [
      'We collect information:',
      {
        list: [
          'directly from you when you create an account, enter profile or birth information, use chat or reports, make a purchase, or contact us;',
          'automatically when you use the Service; and',
          'from third parties that you use in connection with the Service, such as authentication providers and application stores.',
        ],
      },
    ],
  },
  {
    id: 'how-we-use',
    title: 'How we use information',
    body: [
      'We use personal information to:',
      {
        list: [
          'create and manage your account;',
          'calculate astrological information and provide personalized readings, reports, and conversations;',
          'preserve continuity across your interactions with the Service;',
          'process and verify purchases, administer credits, and address transaction issues;',
          'provide customer support and respond to requests;',
          'maintain, secure, troubleshoot, and improve the Service;',
          'prevent fraud, abuse, and violations of our Terms of Service;',
          'comply with legal, accounting, tax, and regulatory obligations; and',
          'establish, exercise, or defend legal claims.',
        ],
      },
      'If the laws of the European Economic Area (“EEA”) or United Kingdom apply, we process personal data on one or more of the following legal bases:',
      {
        list: [
          'contract, when processing is necessary to provide the Service you request;',
          'legitimate interests, such as securing and improving the Service, preventing fraud, and protecting users and our business, where those interests are not overridden by your rights;',
          'legal obligations, when applicable law requires processing; and',
          'consent, where we specifically ask for it. You may withdraw consent at any time, without affecting processing that occurred before withdrawal.',
        ],
      },
    ],
  },
  {
    id: 'ai-processing',
    title: 'AI processing',
    body: [
      'Mirinae uses artificial-intelligence service providers to generate readings, reports, and chat responses. To provide these features, we send those providers the content you submit and relevant context, which may include your profile, birth and chart information, prior conversation context, and personalization information. The providers process this information to return generated content and support the security and reliability of the service they provide to us.',
      'We do not use your personal information to train a model of our own. Third-party AI providers may retain or use the information they receive, including to improve their services or models, as permitted by their terms and the data-use settings applied to a request. Those practices may vary by provider.',
      'We do not use AI to make decisions that produce legal or similarly significant effects about you.',
    ],
  },
  {
    id: 'how-we-disclose',
    title: 'How we disclose information',
    body: [
      'We may disclose personal information to the following categories of recipients:',
      {
        list: [
          'hosting, database, and authentication providers that store information and operate account access;',
          'AI and personalization providers that generate content and support continuity across interactions;',
          'application stores and transaction-service providers that process, verify, or reconcile purchases and refunds;',
          'security, diagnostics, and customer-support providers that help us protect, troubleshoot, and support the Service;',
          'professional advisers, such as lawyers, accountants, auditors, and insurers;',
          'government authorities or other parties when disclosure is required by law or reasonably necessary to protect rights, safety, security, or property; and',
          'participants in a corporate transaction, such as an acquisition, financing, reorganization, or sale of all or part of our business, subject to appropriate confidentiality protections.',
        ],
      },
      'We may also disclose information at your direction or with your consent.',
      'We do not sell personal information, and we do not disclose personal information for cross-context behavioral advertising. We do not use the content of your chats, report inputs, or reports for advertising.',
    ],
  },
  {
    id: 'international-transfers',
    title: 'International data transfers',
    body: [
      'We and our service providers may process personal information in countries other than the country where you live. Those countries may have different data-protection laws. Where required, we use safeguards recognized by applicable law. For transfers from the EEA, we rely on applicable adequacy decisions or the European Commission’s Standard Contractual Clauses. For transfers from the United Kingdom, we rely on applicable adequacy regulations or the UK International Data Transfer Addendum or International Data Transfer Agreement, as appropriate.',
    ],
  },
  {
    id: 'retention',
    title: 'Data retention and deletion',
    body: [
      'We retain personal information for as long as reasonably necessary to provide the Service and fulfill the purposes described in this policy. The period depends on the type of information, the duration of your account, and applicable legal, accounting, tax, security, fraud-prevention, and dispute-resolution needs.',
      `You may delete your account through the account settings or request deletion at ${SUPPORT_EMAIL}. When an account is deleted, we delete or de-identify the personal information associated with it, subject to limited exceptions. We may retain information where necessary to comply with law, maintain transaction records, resolve disputes, prevent fraud or repeated claims of a one-time benefit, enforce our agreements, or complete deletion from backups and service providers. Information that has been aggregated or de-identified so that it no longer identifies you may be retained.`,
    ],
  },
  {
    id: 'your-rights',
    title: 'Your rights and choices',
    body: [
      'Depending on where you live, you may have the right to:',
      {
        list: [
          'request access to or a copy of your personal information;',
          'correct inaccurate personal information;',
          'request deletion of personal information;',
          'request restriction of or object to certain processing;',
          'receive certain information in a portable format;',
          'withdraw consent where processing relies on consent; and',
          'appeal our response or complain to a data-protection authority.',
        ],
      },
      `You can update certain profile and birth information or delete your account in the Service. To exercise another right, contact ${SUPPORT_EMAIL}. We may need to verify your identity before completing a request. These rights may be limited where an exception under applicable law applies, including where we must retain information to comply with law or protect the rights of others. We will not discriminate against you for exercising a privacy right.`,
    ],
  },
  {
    id: 'security',
    title: 'Security',
    body: [
      'We use reasonable administrative, technical, and organizational measures designed to protect personal information. However, no method of transmission or storage is completely secure, and we cannot guarantee absolute security. If a security incident requires notice under applicable law, we will provide that notice as required.',
    ],
  },
  {
    id: 'children',
    title: 'Children',
    body: [
      'The Service is not intended for children under 13, and you must be at least 13 years old to use it. If you are under the age of legal majority where you live, a parent or legal guardian must review and agree to our Terms of Service on your behalf.',
      `We do not knowingly collect personal information from children under 13. If we learn that we have done so, we will take reasonable steps to delete the information and close the account. A parent or guardian who believes a child under 13 has provided us with personal information may contact ${SUPPORT_EMAIL}.`,
    ],
  },
  {
    id: 'changes',
    title: 'Changes to this policy',
    body: [
      'We may update this policy to reflect changes to the Service, our practices, or applicable law. We will post the updated policy and revise the date above. If a change materially affects your rights or how we use personal information, we will provide additional notice as required by law.',
    ],
  },
  {
    id: 'contact',
    title: 'Contact us',
    body: [
      'For privacy questions, requests, or complaints, contact:',
      {
        list: [
          `Privacy: ${SUPPORT_EMAIL}`,
          `Support: ${SUPPORT_EMAIL}`,
          `Postal address: ${COMPANY.legalName}, ${COMPANY.address}`,
        ],
      },
    ],
  },
];
---

<Layout
  title={`Privacy Policy — ${SITE.name}`}
  description="How Mirinae collects, uses, discloses, and protects your personal information.">
  <LegalDoc title="Privacy Policy" updated={PRIVACY_UPDATED} sections={sections} />
</Layout>
