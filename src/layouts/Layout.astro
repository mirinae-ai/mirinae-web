---
import '@fontsource-variable/inter';
import '../styles/global.css';
import { SITE } from '../config';

interface Props {
  title: string;
  description?: string;
  /** 공유 미리보기 이미지. `public/` 기준 경로다. */
  image?: string;
}

const { title, description = SITE.description, image = '/og.png' } = Astro.props;

/*
 * og:image 와 canonical 은 절대 URL 이어야 한다 — 미리보기를 만드는 쪽은 우리 페이지의
 * 위치를 모른 채 이 값만 보고 가져간다. 기준 주소는 `astro.config.mjs` 의 `site` 이고,
 * 배포 환경이 알려 준 값이 거기 들어 있다.
 */
const base = Astro.site!;
const canonical = new URL(Astro.url.pathname, base).href;
const ogImage = new URL(image, base).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fcfcfc" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Miru, the Mirinae mascot" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Miru, the Mirinae mascot" />
  </head>
  <body>
    <slot />
  </body>
</html>
